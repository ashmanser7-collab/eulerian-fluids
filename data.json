{
    "name": "Eulerian Fluids Simulation",
    "id": "grid-fluids",
    "variables": [
        {"id": "cell_size", "min": 1, "max": 64, "step": 0.1, "type": "constant", "default": 8},
        {"id": "density", "min": 0.1, "max": 10, "step": 0.01, "type": "active", "default": 1},
        {"id": "dt", "min": 0.01, "max": 1, "step": 0.01, "type": "active", "default": 0.1},
        {"id": "relaxation", "min": 0, "max": 1, "step": 0.01, "type": "constant", "default": 1},
        {"id": "emission_size", "min": 1, "max": 50, "step": 1, "type": "active", "default": 10},
        {"id": "smoke_emission", "min": 0, "max": 1, "step": 0.005, "type": "active", "default": 0.05},
        {"id": "velocity_emission", "min": 0, "max": 25, "step": 0.1, "type": "active", "default": 5},
        {"id": "mouse_radius", "min": 0, "max": 10, "step": 0.5, "type": "active", "default": 3},
        {"id": "mouse_strength", "min": 0, "max": 10, "step": 0.1, "type": "active", "default": 2}
    ],
    "description": "",
    "controls": ""
